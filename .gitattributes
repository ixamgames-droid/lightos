# Alle Textdateien: LF im Repo, CRLF beim Checkout auf Windows
* text=auto eol=lf

# Shell-Skripte immer LF
*.sh text eol=lf

# Windows-Batch immer CRLF
*.bat text eol=crlf

# Binaere Dateien
*.png binary
*.ico binary
*.db  binary

# PROC-22: Listen, an die jeder Zweig eine eigene Zeile haengt. „union“ behaelt
# beim Mergen die Zeilen beider Seiten, statt an derselben Stelle zu kollidieren.
tools/doku_gates.txt merge=union
